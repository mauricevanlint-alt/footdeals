import { getStore } from "@netlify/blobs";const json=(b,s=200)=>new Response(JSON.stringify(b),{status:s,headers:{"content-type":"application/json; charset=utf-8","cache-control":"no-store"}});const adminOK=req=>{const x=Netlify.env.get("FOOTDEALS_ADMIN_SECRET")||"";return !!x&&(req.headers.get("authorization")||"")===`Bearer ${x}`};function p(k){return (k.split('/')[1]||'').split('__')}function day(s){return String(s||'').slice(0,10)}export default async req=>{if(req.method!=='GET')return json({error:'Méthode non autorisée'},405);if(!adminOK(req))return json({error:'Accès administrateur requis'},401);try{const st=getStore({name:'footdeals-events'}),v=(await st.list({prefix:'visit/'})).blobs||[],c=(await st.list({prefix:'click/'})).blobs||[],bySource={},byCampaign={},byDeal={},byMerchant={},daily={};for(const x of v){const z=p(x.key),d=day(z[0]);bySource[z[1]||'direct']=(bySource[z[1]||'direct']||0)+1;byCampaign[z[2]||'none']=(byCampaign[z[2]||'none']||0)+1;daily[d]=daily[d]||{visits:0,clicks:0};daily[d].visits++}for(const x of c){const z=p(x.key),d=day(z[0]);bySource[z[1]||'direct']=(bySource[z[1]||'direct']||0);byCampaign[z[2]||'none']=(byCampaign[z[2]||'none']||0);byDeal[z[3]||'0']=(byDeal[z[3]||'0']||0)+1;byMerchant[z[4]||'inconnu']=(byMerchant[z[4]||'inconnu']||0)+1;daily[d]=daily[d]||{visits:0,clicks:0};daily[d].clicks++}const visits=v.length,clicks=c.length;return json({visits,clicks,ctr:visits?Number((clicks/visits*100).toFixed(1)):0,bySource,byCampaign,byDeal,byMerchant,daily:Object.fromEntries(Object.entries(daily).sort().slice(-30))})}catch(e){console.error(e);return json({error:'Statistiques indisponibles'},500)}};export const config={path:"/api/stats"};