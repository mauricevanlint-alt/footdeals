const json=(body,status=200)=>new Response(JSON.stringify(body),{status,headers:{"content-type":"application/json; charset=utf-8","cache-control":"no-store","x-content-type-options":"nosniff"}});
const dataStore=()=>getStore({name:"footdeals-data",consistency:"strong"});const backupStore=()=>getStore({name:"footdeals-backups",consistency:"strong"});
const adminOK=req=>{const s=Netlify.env.get("FOOTDEALS_ADMIN_SECRET")||"";return !!s&&(req.headers.get("authorization")||"")===`Bearer ${s}`};
const text=(v,n=180)=>String(v??"").trim().slice(0,n);const url=v=>{try{const u=new URL(String(v||""));return ["http:","https:"].includes(u.protocol)?u.href:""}catch{return ""}};
const normalize=(raw,old={})=>{const d={...old,...(raw||{})};d.id=Number(d.id)||Date.now();d.cat=["Maillots","Crampons","Vêtements","Équipement"].includes(d.cat)?d.cat:"Équipement";d.brand=text(d.brand,80);d.name=text(d.name,180);d.merchant=text(d.merchant,80);d.kind=text(d.kind,90);d.image_url=url(d.image_url);d.old=Math.max(0,Number(d.old)||0);d.price=Math.max(0,Number(d.price)||0);d.discount=d.old>d.price?Math.round((1-d.price/d.old)*100):0;d.url=url(d.url);d.source=text(d.source,120);d.affiliate=Boolean(d.affiliate);d.featured=Boolean(d.featured);d.expires=text(d.expires,20);d.verified_at=text(d.verified_at,50)||new Date().toISOString();d.updated=text(d.updated,30)||new Date().toLocaleDateString("fr-BE");d.verified=text(d.verified,160)||`Vérifié · ${d.updated}`;d.status=["active","draft","paused"].includes(d.status)?d.status:"active";d.share_text=text(d.share_text,220)||`${d.name} à ${d.price.toFixed(2)} € sur FootDeals`;d.notes=text(d.notes,500);d.created_at=text(d.created_at,50)||old.created_at||new Date().toISOString();d.updated_at=new Date().toISOString();return d};
async function readAll(){const store=dataStore();let d=await store.get("deals",{type:"json"});if(!Array.isArray(d)){d=SEED;await store.setJSON("deals",d);await store.set('migration_complete_20260911_final12','1');return d}const migrated=await store.get('migration_complete_20260911_final12');let changed=false;if(!migrated){d=d.map(x=>{const seed=SEED.find(s=>Number(s.id)===Number(x.id));if(!seed)return x;changed=true;return{...x,old:seed.old,price:seed.price,discount:seed.discount,url:seed.url,source:seed.source,verified:seed.verified,verified_at:seed.verified_at,updated:seed.updated,image_url:seed.image_url,notes:seed.notes||x.notes}});for(const seed of SEED)if(!d.some(x=>Number(x.id)===Number(seed.id))){d.push(seed);changed=true}await store.set('migration_complete_20260911_final12','1')}else{d=d.map(x=>{const seed=SEED.find(s=>Number(s.id)===Number(x.id));if(seed&&seed.image_url&&!x.image_url){changed=true;return{...x,image_url:seed.image_url}}return x})}if(changed)await store.setJSON("deals",d);return d}async function saveAll(d){await dataStore().setJSON("deals",d)}
async function backup(d,reason){const key=`deals/${new Date().toISOString().replace(/[:.]/g,'-')}__${String(reason||'change').replace(/[^a-z0-9_-]+/gi,'-')}`;await backupStore().setJSON(key,{at:new Date().toISOString(),reason,deals:d});const list=(await backupStore().list({prefix:'deals/'})).blobs||[];if(list.length>30){const sorted=[...list].sort((a,b)=>String(b.key).localeCompare(String(a.key)));for(const x of sorted.slice(30))await backupStore().delete(x.key)}}
function activeOnly(d){const now=Date.now();return d.filter(x=>x.status==='active').filter(x=>{if(!x.expires)return true;const t=new Date(x.expires+'T23:59:59').getTime();return !Number.isFinite(t)||t>=now})}
export default async(req,context)=>{try{const all=await readAll();if(req.method==='GET')return json({deals:adminOK(req)?all:activeOnly(all),live:true,updatedAt:new Date().toISOString()});if(!adminOK(req))return json({error:'Accès administrateur requis'},401);const id=Number(context.params?.id||0);if(req.method==='POST'){const b=await req.json().catch(()=>({}));await backup(all,'before-create');const next=Math.max(100,...all.map(x=>Number(x.id)||0))+1;const deal=normalize({...b,id:next});const d=[deal,...all];await saveAll(d);return json({deal,deals:d},201)}if(req.method==='PUT'){if(!id)return json({error:'ID manquant'},400);const i=all.findIndex(x=>Number(x.id)===id);if(i<0)return json({error:'Offre introuvable'},404);await backup(all,'before-update-'+id);const b=await req.json().catch(()=>({}));all[i]=normalize({...b,id},all[i]);await saveAll(all);return json({deal:all[i],deals:all})}if(req.method==='DELETE'){if(!id)return json({error:'ID manquant'},400);if(!all.some(x=>Number(x.id)===id))return json({error:'Offre introuvable'},404);await backup(all,'before-delete-'+id);const d=all.filter(x=>Number(x.id)!==id);await saveAll(d);return json({ok:true,deals:d})}return json({error:'Méthode non autorisée'},405)}catch(e){console.error(e);return json({error:'Erreur serveur FootDeals'},500)}};
