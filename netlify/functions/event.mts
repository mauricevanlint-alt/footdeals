import { getStore } from "@netlify/blobs";const json=(b,s=200)=>new Response(JSON.stringify(b),{status:s,headers:{"content-type":"application/json; charset=utf-8","cache-control":"no-store"}});const slug=(v,n=50)=>String(v||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9_-]+/g,'-').replace(/^-+|-+$/g,'').slice(0,n)||'none';export default async req=>{if(req.method!=='POST')return json({error:'Méthode non autorisée'},405);try{const b=await req.json();if(b.type!=='visit')return json({error:'Type invalide'},400);const at=new Date().toISOString(),source=slug(b.source,30),campaign=slug(b.campaign,50),id=crypto.randomUUID();await getStore({name:'footdeals-events'}).set(`visit/${at}__${source}__${campaign}__${id}`,'1');return json({ok:true},201)}catch{return json({error:'Événement invalide'},400)}};export const config={path:"/api/event"};