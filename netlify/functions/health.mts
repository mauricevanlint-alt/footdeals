import { getStore } from "@netlify/blobs";export default async()=>{try{const st=getStore({name:'footdeals-data'}),deals=await st.get('deals',{type:'json'}),settings=await st.get('settings',{type:'json'});return Response.json({ok:true,service:'FootDeals',api:'complete',deals:Array.isArray(deals)?deals.length:0,active:Array.isArray(deals)?deals.filter(x=>x.status==='active').length:0,launch:Boolean(settings?.launch),time:new Date().toISOString()},{headers:{'cache-control':'no-store'}})}catch{return Response.json({ok:false},{status:500})}};export const config={path:"/api/health"};