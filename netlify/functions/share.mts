import { getStore } from "@netlify/blobs";const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));export default async(req,context)=>{const id=Number(context.params?.id||0);try{const deals=await getStore({name:'footdeals-data',consistency:'strong'}).get('deals',{type:'json'});const d=Array.isArray(deals)?deals.find(x=>Number(x.id)===id&&x.status==='active'):null;if(!d)return new Response('Deal introuvable',{status:404});const q=new URL(req.url).search;const target=`/?deal=${id}${q?q.replace(/^\?/,'&'):''}`;const title=esc(`${d.name} — ${Number(d.price).toLocaleString('fr-BE')} € | FootDeals`),desc=esc(`-${d.discount}% chez ${d.merchant} · offre vérifiée sur FootDeals`),img=esc(/^https:\/\//.test(String(d.image_url||''))?d.image_url:'https://footdeals.netlify.app/assets/og-footdeals.jpg');return new Response(`<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta property="og:type" content="website"><meta property="og:title" content="${title}"><meta property="og:description" content="${desc}"><meta property="og:image" content="${img}"><meta property="og:url" content="https://footdeals.netlify.app/d/${id}"><meta name="twitter:card" content="summary_large_image"><title>${title}</title><meta http-equiv="refresh" content="0;url=${esc(target)}"></head><body><p>Ouverture de FootDeals…</p><script>location.replace(${JSON.stringify(target)})</script></body></html>`,{headers:{'content-type':'text/html; charset=utf-8','cache-control':'public,max-age=300'}})}catch(e){return new Response('Erreur FootDeals',{status:500})}};export const config={path:"/d/:id"};