import { getStore } from "@netlify/blobs";const slug=(v,n=50)=>String(v||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9_-]+/g,'-').replace(/^-+|-+$/g,'').slice(0,n)||'none';export default async(req,context)=>{const id=Number(context.params?.id||0);if(!id)return new Response('Deal invalide',{status:400});try{const deals=await getStore({name:'footdeals-data',consistency:'strong'}).get('deals',{type:'json'});const d=Array.isArray(deals)?deals.find(x=>Number(x.id)===id&&x.status==='active'):null;if(!d||!d.url)return new Response('Deal indisponible',{status:404});let target;try{target=new URL(String(d.url));if(!['http:','https:'].includes(target.protocol))throw new Error('bad protocol')}catch{return new Response('Lien marchand invalide',{status:502})}const u=new URL(req.url),source=slug(u.searchParams.get('src')||'direct',30),campaign=slug(u.searchParams.get('campaign')||'none',50),at=new Date().toISOString(),eid=crypto.randomUUID();await getStore({name:'footdeals-events'}).set(`click/${at}__${source}__${campaign}__${id}__${slug(d.merchant,40)}__${eid}`,'1');return Response.redirect(target.href,302)}catch(e){console.error(e);return new Response('Redirection indisponible',{status:500})}};export const config={path:"/out/:id"};